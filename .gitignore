# --- simulations: only the examples (mesh + parameters) are versioned -------
/FlowPro/simulations/*
!/FlowPro/simulations/examples/
/FlowPro/simulations/examples/**/W.txt
/FlowPro/simulations/examples/**/We.txt
/FlowPro/simulations/examples/**/state.txt
/FlowPro/simulations/examples/**/residuum.txt
/FlowPro/simulations/examples/**/referenceValues.txt
/FlowPro/simulations/examples/**/artificialViscosity.txt
/FlowPro/simulations/examples/**/PXY.txt
/FlowPro/simulations/examples/**/UXY.txt
