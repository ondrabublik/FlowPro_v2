/FlowPro/simulations/examples/**/STOP
/FlowPro/simulations/examples/**/output/
/FlowPro/simulations/examples/**/animation/
/FlowPro/simulations/examples/GAMMgenerated/mesh/wallDistance.txt

# binaries and MATLAB data which were not versioned in the original FlowPro
# repository (files already in the repository are not affected)
/FlowPro/*.jar
/FlowPro/**/*.mat
/FlowPro/matlab/**/*.txt
/FlowPro/toolbox/solverManager/sims.txt
/FlowProManager/nbproject/
