build/
.gradle/
.nb-gradle/
.nb-gradle-properties
.idea/
*.class
*.tmp
__pycache__/
hs_err_pid*.log
log.out*

# jars built by gradle and copied next to FlowPro.jar
/FlowPro/FlowPro.jar
/FlowPro/FlowPro.zip
/FlowPro/FlowProManager.jar
/FlowPro/FlowProControl.jar
/FlowPro/MeshGenerator2D.jar
/FlowPro/modules/

